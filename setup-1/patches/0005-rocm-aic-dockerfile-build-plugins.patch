From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kv-cache <noreply@localhost>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] rocm-aic: build the XNVME_KV NIXL storage plugin into the image

Carried out-of-tree. See README.md.

Previously built SPDK_NVMe_KV too (plus a from-source SPDK checkout and 4
upstream-style KV command-set patches). Dropped 2026-10-05: setup-1 only
ever deploys XNVME_KV against a local NVMe-KV device node now. See
HANDOFF.md and patches/0001-0004-spdk-*.patch's removal in the same change.
---
diff --git a/docker/Dockerfile b/docker/Dockerfile
index 8e59fd2..14130f6 100644
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -363,6 +363,101 @@ RUN --mount=type=cache,target=/root/.cache/uv \
         UV_SYSTEM_CERTS=1 \
         /tmp/nixl-scripts/build-nixl.sh
 
+# ----- 6a. Custom NIXL storage plugin (XNVME_KV) -----------------------------
+# One out-of-tree NIXL backend plugin from the kv-cache-bench repo (source of
+# truth: stack/tracks/nixl/core/xnvme-kv-plugin/ there -- never forked, only
+# compiled here). It implements NIXL's OBJ_SEG / key-addressed backend API
+# against backend_engine.h, which is byte-identical between NIXL v1.3.2 and
+# current upstream, so it builds cleanly against the /opt/nixl install the
+# previous step just produced with zero NIXL source changes. This is
+# deliberately a plain compile step, not a nixl_patches/ entry -- the plugin
+# is compiled and shlib-installed directly into NIXL_PLUGIN_DIR, exactly like
+# build-nixl.sh's own AIS_MT/Prometheus plugins.
+#
+#   XNVME_KV — io_uring_cmd-based backend via a standalone libxnvme build.
+#
+# Plugin source is staged into the build context at plugins/ by kv-cache-
+# bench's stack/tracks/rocm-aic/build.sh before `docker build`/`make build`
+# runs -- the test below fails loudly if that step was skipped rather than
+# silently building an image with a missing plugin.
+#
+# A second NIXL backend, SPDK_NVMe_KV (kernel-bypass NVMe-oF via SPDK), used
+# to be built here too. Dropped -- this track (setup-1) only ever deploys
+# XNVME_KV against a local NVMe-KV device node now; see HANDOFF.md. If you
+# need SPDK_NVMe_KV again, it's in git history before this change, alongside
+# patches/0001-0004-spdk-*.patch and plugins/nvme-kv/.
+ARG XNVME_GIT_URL=https://github.com/xnvme/xnvme.git
+ARG XNVME_REF=v0.7.5
+
+RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
+    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
+    apt-get update && \
+    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
+        libaio-dev \
+        liburing-dev \
+        libnuma-dev \
+        libssl-dev \
+        uuid-dev \
+        cmake \
+    && python3 -m pip install --no-cache-dir meson ninja tabulate pyelftools
+
+# nixl_log.h (pulled in transitively by our plugin via backend_engine.h)
+# #includes absl/log/log.h at compile time (symbols themselves resolve at
+# runtime from libnixl.so -- see meson.build's "-Wl,--allow-shlib-undefined"
+# comment below). rocm-aic's own build-nixl.sh never installs Abseil
+# system-wide -- NIXL v1.3.2's meson build resolves it as a private
+# subproject, so its headers aren't on any path our plugin's compiler
+# invocation searches. Fix mirrors stack/tracks/nixl/core/Dockerfile.nixl-base
+# (lines ~94-111) exactly: build the same pinned Abseil release from source
+# with a system install prefix so <absl/log/log.h> resolves like it already
+# does in that image.
+RUN cd /tmp && \
+    git clone --depth 1 --branch 20240722.0 \
+        https://github.com/abseil/abseil-cpp.git abseil-src && \
+    cd abseil-src && \
+    cmake -B build \
+        -DABSL_BUILD_TESTING=OFF \
+        -DCMAKE_BUILD_TYPE=Release \
+        -DCMAKE_INSTALL_PREFIX=/usr \
+        -DBUILD_SHARED_LIBS=ON \
+        -DABSL_PROPAGATE_CXX_STD=ON \
+        -DCMAKE_CXX_STANDARD=17 && \
+    cmake --build build -j"$(nproc)" && \
+    cmake --install build && \
+    ldconfig && \
+    rm -rf /tmp/abseil-src
+
+COPY plugins/ /tmp/kv-plugins/
+RUN test -d /tmp/kv-plugins/xnvme-kv-plugin \
+    || { echo "ERROR: /tmp/kv-plugins/xnvme-kv-plugin not found -- run kv-cache-bench's stack/tracks/rocm-aic/build.sh staging step before docker build" >&2; exit 1; }
+
+# --- libxnvme ${XNVME_REF} (standalone build, not the SPDK-vendored copy) ----
+RUN git clone --depth 1 --branch "${XNVME_REF}" "${XNVME_GIT_URL}" /opt/xnvme-src && \
+    cd /opt/xnvme-src && \
+    meson setup build \
+        -Dtests=false -Dexamples=false -Dtools=false -Dwith-spdk=disabled \
+        --buildtype=release && \
+    ninja -C build && \
+    ninja -C build install && \
+    ldconfig
+
+RUN mkdir -p /tmp/xnvme-kv-build && \
+    meson setup /tmp/xnvme-kv-build /tmp/kv-plugins/xnvme-kv-plugin \
+        -Dnixl_path=/opt/nixl \
+        -Dxnvme_incdir=/usr/local/include \
+        -Dxnvme_libdir=/usr/local/lib/x86_64-linux-gnu \
+        -Drocm_path=/opt/rocm \
+        -Denable_vram=true \
+        --prefix=/opt/nixl \
+        --buildtype=release && \
+    ninja -C /tmp/xnvme-kv-build && \
+    ninja -C /tmp/xnvme-kv-build install && \
+    test -f /opt/nixl/lib/x86_64-linux-gnu/plugins/libplugin_XNVME_KV.so
+# libxnvme.so is linked via -Wl,-rpath (see xnvme-kv-plugin/meson.build), not
+# statically -- `ldconfig` above registers /usr/local/lib/x86_64-linux-gnu,
+# already on this image's default ld.so search path, so no LD_LIBRARY_PATH
+# change is needed for the runtime stage below.
+
 # ----- 6b. hsa-snoop (HSA AQL queue snooper + Prometheus exporter) -----------
 # GPU dispatch/queue telemetry on :9488 (/metrics), including AIS (AMD Infinity
 # Storage) P2P metrics (ais_rx_ops_total, ais_tx_bytes_total, etc.) added in
