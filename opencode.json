{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",

      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "stat *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "df *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "tr *": "allow",
      "cut *": "allow",
      "diff *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "pwd": "allow",
      "true": "allow",
      "date *": "allow",
      "sleep *": "allow",

      "bash *": "allow",
      "sh *": "allow",
      "python3 *": "allow",
      "shellcheck *": "allow",
      "timeout *": "allow",
      "tee *": "allow",
      "xargs *": "allow",
      "mkdir *": "allow",
      "chmod *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "ln *": "allow",
      "touch *": "allow",

      "git *": "allow",
      "npm *": "allow",

      "ssh *": "allow",
      "scp *": "allow",
      "sshpass *": "allow",
      "rsync *": "allow",
      "ping *": "allow",
      "nc *": "allow",
      "ss *": "allow",
      "curl *": "allow",
      "ip *": "allow",
      "docker *": "allow",
      "nvme *": "allow",
      "lspci *": "allow",
      "lsmod *": "allow",
      "modinfo *": "allow",
      "dkms *": "allow",
      "rocm-smi *": "allow",
      "rocminfo *": "allow",
      "ibv_devinfo *": "allow",

      "./scripts/*": "allow",
      "scripts/*": "allow",

      "cd /home/pmallapp/share/proj/kv-cache*": "allow",
      "source config/*": "allow",
      "source creds/*": "allow",

      "rm *": "deny",
      "* && rm *": "deny",
      "* ; rm *": "deny",
      "*; rm *": "deny",
      "* | rm *": "deny",
      "sudo rm *": "deny",
      "*xargs rm*": "deny",
      "*find * -delete*": "deny",
      "*mkfs*": "deny",
      "*dd if=*": "deny",
      "*shutdown*": "deny",
      "*reboot*": "deny",
      "*poweroff*": "deny",
      "*init 0*": "deny",
      "*init 6*": "deny",
      "* > /dev/sd*": "deny",
      "* > /dev/nvme*": "deny",
      "*mkswap*": "deny",
      "*wipefs*": "deny",
      "*fdisk*": "deny",
      "*parted*": "deny",

      "rm -f /tmp/opencode/*": "allow",
      "rm -rf /tmp/opencode/*": "allow",
      "rm -f /home/pmallapp/share/proj/kv-cache/creds/*.bak-*": "allow"
    }
  }
}
