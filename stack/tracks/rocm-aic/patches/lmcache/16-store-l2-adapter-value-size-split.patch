+    def _expand_split_indices(self, mem_indices, storage_indices):
+        """Expand each logical page/slot index into mem_split_n consecutive
+        sub-descriptor indices.
+
+        Correct because init_mem_handlers() and init_storage_handlers_object()
+        above both lay out each logical index's n sub-descriptors as n
+        *consecutive* entries in their respective registered lists (positions
+        [idx*n, idx*n+n)) - so multiplying by n and expanding a range
+        reproduces the exact positions, on both the mem and storage sides, in
+        matching order. Position k in the expanded mem list and position k in
+        the expanded storage list therefore always refer to the same
+        sub-part j of the same logical (mem page, storage slot) pair.
+        """
+        if self.mem_split_n == 1:
+            return mem_indices, storage_indices
+        n = self.mem_split_n
+        expanded_mem = [idx * n + j for idx in mem_indices for j in range(n)]
+        expanded_storage = [idx * n + j for idx in storage_indices for j in range(n)]
+        return expanded_mem, expanded_storage
