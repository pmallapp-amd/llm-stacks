+    def _resolve_mem_split(self, page_size: int) -> int:
+        """How many <=max_value_size sub-descriptors one page/slot needs.
+
+        Queries the backend's declared max_value_size (only discoverable via
+        get_plugin_params() - NIXL core doesn't negotiate this automatically)
+        and, if the page size exceeds it, returns the number of equal-ish
+        sub-descriptors each page must be split into so no single transfer
+        descriptor - and therefore no single on-wire KV value - exceeds the
+        backend's limit. Backends that don't declare max_value_size (OBJ,
+        AZURE_BLOB, file-based backends) get 1, i.e. unchanged behavior.
+        """
+        params = self.nixl_agent.get_plugin_params(self.backend)
+        max_size_str = params.get("max_value_size") if params else None
+        logger.info(
+            "nixl_store backend %s: page_size=%d, declared max_value_size=%r",
+            self.backend,
+            page_size,
+            max_size_str,
+        )
+        if not max_size_str:
+            return 1
+        max_size = int(max_size_str)
+        if max_size <= 0 or page_size <= max_size:
+            return 1
+        n = (page_size + max_size - 1) // max_size
+        logger.info(
+            "nixl_store backend %s declares max_value_size=%d < page_size=%d; "
+            "splitting each page/slot into %d sub-objects",
+            self.backend,
+            max_size,
+            page_size,
+            n,
+        )
+        return n
+
