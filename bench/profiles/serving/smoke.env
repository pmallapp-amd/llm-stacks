# serving/smoke — "did the track deploy and does it answer", in a minute or two.
#
# One depth, one concurrency, short generations, no TUI. Enough to prove the
# endpoint is up and the model responds; nowhere near enough to compare tracks.
# Stamped SMOKE, so the numbers cannot later be mistaken for a comparison.

PROFILE_VERDICT=SMOKE
PROFILE_SUMMARY=single-point serving check; proves the endpoint answers, measures nothing
PROFILE_CAVEAT=Smoke configuration - one depth, one concurrency, tiny sample. Latency/throughput here are not comparable to anything.

DEPTH=0
PP=512
TG=64
CONCURRENCY=1
NUM_PROMPTS=20
MAX_TOKENS=64
EXACT_TG=1
PREFIX_CACHING=0
LATENCY_MODE=generation
VIZ=0
