# serving/pd-handoff — the prefill/decode split, where KV really does move
# between two processes.
#
# Used with the PD=both benchmarks (stack/tracks/nixl/vllm/05-llm.sh,
# stack/tracks/mooncake/vllm/02-bench.sh): the PD=0 vs PD=1 delta is the whole
# point, so both halves must run under identical client-side settings or the
# delta is noise. That is the only reason this is a separate profile from
# serving/throughput: PD=both is the intent.
#
# Longer generations than serving/throughput because TTFT is the metric the
# handoff actually moves, and a short generation buries it in decode time.

PROFILE_VERDICT=VALIDATED
PROFILE_SUMMARY=prefill/decode disaggregation - baseline vs P/D under identical client settings
PROFILE_CAVEAT=Only the PD=0 vs PD=1 DELTA is meaningful here; the absolute numbers depend on how the two instances share the GPU (GPU_MEM_UTIL) and are not comparable across deployments.

PD=both
DEPTH=0 4096
PP=512 1024
TG=256
CONCURRENCY=1 16
NUM_PROMPTS=200
MAX_TOKENS=256
EXACT_TG=1
PREFIX_CACHING=0
LATENCY_MODE=generation
VIZ=0
