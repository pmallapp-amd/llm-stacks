# serving/throughput — the cross-track serving comparison sweep.
#
# Why these values:
#   EXACT_TG=1        forces the output length (min_tokens + ignore_eos). Without
#       it each track generates however many tokens its model felt like, and the
#       resulting tok/s are not comparable — the single most common way a
#       cross-track serving comparison quietly becomes meaningless.
#   PREFIX_CACHING=0  vLLM's own prefix cache can serve repeated content without
#       the KV-transfer layer ever being involved, which is exactly the masking
#       effect investigated on 2026-08-11/12. Off by default here.
#   VIZ=0             the live TUI is for a human watching a run; a profiled or
#       manifest-driven sweep is usually unattended and wants plain output.
#       Set VIZ=1 on the command line when you are watching (env wins).
#   CONCURRENCY/DEPTH/PP are the sweep this repo has historical data at, so new
#       runs stay comparable with results/*/2026-08-1*-llama-benchy/.
#
# NUM_PROMPTS/MAX_TOKENS are read by the vLLM-side serving benchmarks
# (stack/tracks/nixl/vllm/05-llm.sh, stack/tracks/mooncake/vllm/02-bench.sh);
# DEPTH/PP/TG/CONCURRENCY are read by bench/llama-benchy. One profile covers
# both because they describe the same intent in two tools' vocabularies.

PROFILE_VERDICT=VALIDATED
PROFILE_SUMMARY=cross-track serving sweep - fixed output length, prefix cache off
PROFILE_CAVEAT=llama-benchy's sweep draws fresh content per cell and does not exercise KV store/retrieve. This measures end-to-end serving throughput of a deployed track, NOT the cost of KV offload - use bench/kv-spillover-probe for that.

DEPTH=0 4096 8192 16384
PP=512 1024
TG=256
CONCURRENCY=1 4 16
NUM_PROMPTS=200
MAX_TOKENS=256
EXACT_TG=1
PREFIX_CACHING=0
LATENCY_MODE=generation
VIZ=0
