# storage/correctness — is the data that comes back the data that went in?
#
# Same tuned shape as storage/throughput (so a failure is attributable to the
# path, not to a starved configuration) but with check_consistency=1 and a
# shorter sweep, because per-transfer verification is expensive.
#
# The verdict is VALIDATED — this is a properly configured run — but its
# BANDWIDTH is not comparable to a throughput run, hence the caveat, which the
# provenance stamp reproduces on every result file.

PROFILE_VERDICT=VALIDATED
PROFILE_SUMMARY=tuned sweep with per-transfer data verification (check_consistency=1)
PROFILE_CAVEAT=check_consistency=1 adds a verification pass to every transfer. The bandwidth in this run is NOT comparable with a storage/throughput run and must not be quoted as a throughput figure.

ITERS=256
WARMUP_ITERS=32
NUM_THREADS=4
PIPELINE_DEPTH=32
NIXL_KV_NUM_QPAIRS=4
NIXL_XNVME_NUM_QUEUES=4
MAX_BATCH_SIZE=8
USE_HUGEPAGES=1
CHECK_CONSISTENCY=1
STORAGE_ENABLE_DIRECT=1
INITIATOR_SEG=DRAM
