# storage/smoke — "does this path work at all", in under a minute.
#
# Degraded knobs are DELIBERATE here: the point is a fast functional signal
# after a rebuild, a reboot, or a plugin change — not a number. check_consistency
# is ON because correctness is the only thing a smoke run is actually measuring.
#
# Every run under this profile is stamped SMOKE. The preflight gate will list
# the degraded knobs as findings and will NOT refuse (SMOKE already declares the
# run non-representative), but those findings are still recorded in the stamp.

PROFILE_VERDICT=SMOKE
PROFILE_SUMMARY=fast functional check; deliberately degraded knobs, not a measurement
PROFILE_CAVEAT=Smoke configuration. Bandwidth/latency from this run are meaningless as performance figures - they exist only to prove the path completes without error.

ITERS=64
WARMUP_ITERS=8
NUM_THREADS=1
PIPELINE_DEPTH=1
NIXL_KV_NUM_QPAIRS=1
NIXL_XNVME_NUM_QUEUES=1
MAX_BATCH_SIZE=2
USE_HUGEPAGES=0
CHECK_CONSISTENCY=1
STORAGE_ENABLE_DIRECT=1
INITIATOR_SEG=DRAM
