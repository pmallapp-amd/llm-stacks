# Deny-by-default allowlist.
#
# Only the paths explicitly un-ignored below are published. Everything else in
# this working tree stays local, including all results, analysis, runbooks and
# any material describing specific storage hardware. Excluded files are never
# named here - listing them would defeat the point.

/*
!/.gitignore
!/LICENSE
!/README.md
!/bench
!/stack
!/tools
!/validation

/bench/*
!/bench/lib
!/bench/llama-benchy
!/bench/manifests
!/bench/pd-disaggregation
!/bench/profiles

/stack/*
!/stack/tracks

/tools/*
!/tools/sync-to-remote.sh
!/tools/sync-watch.sh

/validation/*
!/validation/hip-ipc
!/validation/kv-handoff

/bench/lib/*
!/bench/lib/deployment.sh
!/bench/lib/profiles.sh
!/bench/lib/tracks.sh

/bench/llama-benchy/*
!/bench/llama-benchy/README.md
!/bench/llama-benchy/run.sh

/bench/manifests/*
!/bench/manifests/cross-track-serving.manifest

/bench/pd-disaggregation/*
!/bench/pd-disaggregation/deploy-pd-asymmetric-p2p.sh
!/bench/pd-disaggregation/deploy-pd-disaggregated.sh
!/bench/pd-disaggregation/disagg_proxy_demo.py
!/bench/pd-disaggregation/run-2node-bench.sh

/bench/profiles/*
!/bench/profiles/serving
!/bench/profiles/storage

/stack/tracks/*
!/stack/tracks/atom
!/stack/tracks/lmcache
!/stack/tracks/mori
!/stack/tracks/nixl

/validation/hip-ipc/*
!/validation/hip-ipc/README.md
!/validation/hip-ipc/ddp_probe.py

/validation/kv-handoff/*
!/validation/kv-handoff/compare-serving-correctness.py

/bench/profiles/serving/*
!/bench/profiles/serving/pd-handoff.env
!/bench/profiles/serving/smoke.env
!/bench/profiles/serving/throughput.env

/bench/profiles/storage/*
!/bench/profiles/storage/correctness.env
!/bench/profiles/storage/smoke.env

/stack/tracks/atom/*
!/stack/tracks/atom/01-pull.sh
!/stack/tracks/atom/03-fix-hf-remote-code.sh

/stack/tracks/lmcache/*
!/stack/tracks/lmcache/lmcache-config-posix-bench.yaml

/stack/tracks/mori/*
!/stack/tracks/mori/01-build.sh
!/stack/tracks/mori/patches
!/stack/tracks/mori/proxy

/stack/tracks/nixl/*
!/stack/tracks/nixl/core
!/stack/tracks/nixl/vllm

/stack/tracks/mori/patches/*
!/stack/tracks/mori/patches/fix_moriio_kv_layout.py

/stack/tracks/mori/proxy/*
!/stack/tracks/mori/proxy/moriio_proxy_health.py
!/stack/tracks/mori/proxy/moriio_toy_proxy_server.py

/stack/tracks/nixl/core/*
!/stack/tracks/nixl/core/01-build-base.sh
!/stack/tracks/nixl/core/03-storage-floor.sh
!/stack/tracks/nixl/core/Dockerfile.n0
!/stack/tracks/nixl/core/patches
!/stack/tracks/nixl/core/rocm-plugin

/stack/tracks/nixl/vllm/*
!/stack/tracks/nixl/vllm/05-llm.sh
!/stack/tracks/nixl/vllm/06-build-vllm.sh

/stack/tracks/nixl/core/patches/*
!/stack/tracks/nixl/core/patches/02-tomlplusplus-hip.patch
!/stack/tracks/nixl/core/patches/03-libfabric-amd-accel-detect.patch
!/stack/tracks/nixl/core/patches/04-libfabric-rocm-hmem.patch
!/stack/tracks/nixl/core/patches/05-ucx-amd-gpu-tests.patch

/stack/tracks/nixl/core/rocm-plugin/*
!/stack/tracks/nixl/core/rocm-plugin/build.sh
!/stack/tracks/nixl/core/rocm-plugin/meson.build
!/stack/tracks/nixl/core/rocm-plugin/meson_options.txt
!/stack/tracks/nixl/core/rocm-plugin/src

/stack/tracks/nixl/core/rocm-plugin/src/*
!/stack/tracks/nixl/core/rocm-plugin/src/rocm_backend.cpp
!/stack/tracks/nixl/core/rocm-plugin/src/rocm_backend.h
!/stack/tracks/nixl/core/rocm-plugin/src/rocm_plugin.cpp

# never commit local host inventory / credentials
*.local.md
*.local.env

# scratch, caches, agent state (belt and braces - already excluded above)
__pycache__/
*.pyc
.opencode/
.codex/
node_modules/
