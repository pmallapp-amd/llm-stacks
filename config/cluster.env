#!/usr/bin/env bash
# cluster.env — single source of truth for the P/D-disaggregated KV cache cluster.
#
# Sourced by every script in scripts/. Override any value by exporting it
# before invoking a script, or by editing this file. Nothing here is secret
# beyond what already lives in this private repo.
#
#   source config/cluster.env
#
# shellcheck disable=SC2034

# ─────────────────────────────────────────────────────────────────────────────
# Per-setup identity  —  sourced from an untracked creds file
# ─────────────────────────────────────────────────────────────────────────────
# Addresses, usernames, passwords and console endpoints are lab-specific and
# this repo is public, so none of them live here. They come from creds/, which
# is gitignored in its entirety:
#
#   creds/setup-4.env    the live lab (SMC1/SMC2/SMC3)
#   creds/active.env     symlink -> whichever setup-N.env is current
#
# Sourced FIRST so every value below degrades to `${VAR:-placeholder}` and the
# real value always wins. To stand up a different lab, copy setup-4.env to
# setup-N.env, edit it, and repoint the symlink:
#
#   ln -sfn setup-N.env creds/active.env
#
# Override the file outright with CREDS_FILE=/path/to/other.env.
CREDS_FILE="${CREDS_FILE:-${REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}/creds/active.env}"
if [ -r "${CREDS_FILE}" ]; then
    # shellcheck source=/dev/null
    . "${CREDS_FILE}"
fi

# ─────────────────────────────────────────────────────────────────────────────
# Node topology
# ─────────────────────────────────────────────────────────────────────────────
# SMC1 — prefill  : 8x MI300X [1dd8:5303], 2x DSC3-2Q400 [1dd8:5200]
# SMC2 — decode   : 8x MI300X [1dd8:5303], 2x DSC3-2Q400 [1dd8:5200]
# SMC3 — target   : no GPU, 2x POLLARA-1Q400 [1dd8:1002] @ 64:00.0, 84:00.0
#
# SMC3 is the physical KV store: it runs SPDK nvmf_tgt, exporting a KV
# namespace over NVMe-oF/TCP, which SMC1/SMC2 reach as their KV storage tier
# (see "NVMe-oF target" / "KV namespace geometry" below). It is not a
# secondary/optional node — it is the storage leg (leg B).
#
# The placeholders use the reserved .invalid TLD (RFC 2606) deliberately: with
# no creds file present every lookup fails immediately and unmistakably, rather
# than resolving to something real and pointing the cluster at a stranger's box.
PREFILL_HOST="${PREFILL_HOST:-prefill.invalid}"
DECODE_HOST="${DECODE_HOST:-decode.invalid}"
TARGET_HOST="${TARGET_HOST:-target.invalid}"

# ── N-prefill/M-decode upgrade seam ─────────────────────────────────────────
# The one supported architecture is P/D disaggregated: prefill on one node,
# decode on another. Today that's 1P1D. Growing to N-prefill/M-decode MUST be
# a change of VALUES here, not a change of structure — that is what
# PREFILL_HOSTS/DECODE_HOSTS exist for.
#
# PREFILL_HOST/DECODE_HOST (singular, above) stay the canonical FIRST element
# / "the local instance": role self-detection (require_host, setup_pd_env,
# etc.) and most scripts key off the singular, so it cannot be retired just
# because a list now also exists.
#
# PREFILL_HOSTS/DECODE_HOSTS (plural, space-separated) are the fleet. They
# default to a single-entry list built from the singular, so 1P1D keeps
# working unmodified. Going to NPMD means adding entries to the plurals
# (PREFILL_HOSTS="h1 h2 h3") plus teaching the proxy to load-balance across
# them — no structural change to this file or to lib.sh.
PREFILL_HOSTS="${PREFILL_HOSTS:-${PREFILL_HOST}}"
DECODE_HOSTS="${DECODE_HOSTS:-${DECODE_HOST}}"

PREFILL_NAME="${PREFILL_NAME:-prefill}"
DECODE_NAME="${DECODE_NAME:-decode}"
TARGET_NAME="${TARGET_NAME:-target}"

SSH_USER="${SSH_USER:-root}"

# BMCs (out-of-band). Credentials live in the creds file, never here.
PREFILL_BMC="${PREFILL_BMC:-prefill-bmc.invalid}"
DECODE_BMC="${DECODE_BMC:-decode-bmc.invalid}"
TARGET_BMC="${TARGET_BMC:-target-bmc.invalid}"

# ─────────────────────────────────────────────────────────────────────────────
# Transport selection  —  compute leg only
# ─────────────────────────────────────────────────────────────────────────────
# KV_TRANSPORT drives the COMPUTE leg only (the direct P<->D NIXL/UCX side
# channel — see setup_ucx_env() below):
#   tcp   Phase 1 (bring-up).   UCX over TCP P<->D.
#   rdma  Phase 2 (acceptance). UCX over RoCE P<->D.
#
# The STORAGE leg (NVMe-oF to SMC3) is TCP ONLY, unconditionally — see the
# "NVMe-oF target" section below. This variable used to ALSO select
# NVMF_TRTYPE=RDMA for the storage leg, but that branch was never validated
# against a real RDMA-capable nvmf_tgt: rocm-aic/target.sh, the PROVEN
# working configuration this repo's target scripts were rewritten from,
# only ever brings the target up on TCP. Carrying forward an unproven RDMA
# branch for the storage leg would just be more inference — the exact thing
# this rewrite was done to remove. If a storage-leg RDMA transport is ever
# needed, that is new work to validate from scratch, not a flag flip on
# code nobody has run.
#
# Flipping this is still the single switch the acceptance criteria turns
# for the compute leg. See docs/BRINGUP.md §9 for the prerequisites RDMA
# adds there (they are NOT no-ops: the SPDK plugin as committed links no
# RDMA transport object — see §9.1).
KV_TRANSPORT="${KV_TRANSPORT:-tcp}"

# ─────────────────────────────────────────────────────────────────────────────
# Compute leg (P->D) — direct NIXL/UCX KV transfer (leg A)
# ─────────────────────────────────────────────────────────────────────────────
# This closes docs/TODO.md §1's biggest gap: vLLM's own NixlConnector,
# composed via MultiConnector alongside LMCacheMPConnector, carrying the
# direct SMC1(prefill) -> SMC2(decode) GPU-to-GPU KV transfer over NIXL/UCX.
# See scripts/common/gen-kv-transfer-config.sh for the exact JSON this
# produces and docs/HANDOFF.md §3 for the two-leg architecture this composes
# with (leg B, the SMC3 storage tier documented further below, is untouched
# by anything here).
#
# This composition is now FIXED, not configurable — there is exactly one
# supported architecture, so the axes that used to select among alternatives
# (PD_ENABLED, PD_CONNECTOR, PD_LMCACHE_FIRST) have been removed as
# variables. The values they used to hold are now hardcoded constants in the
# generator (scripts/common/gen-kv-transfer-config.sh):
#
#   PD disaggregation : always on (formerly PD_ENABLED=1)
#   connector          : always MultiConnector[NixlConnector, LMCacheMPConnector]
#                        (formerly PD_CONNECTOR=MultiConnector)
#   connector order    : always NixlConnector FIRST (formerly PD_LMCACHE_FIRST=0)
#
# The ORDER is not a style choice, and there is no longer a switch to
# reverse it: MultiConnector.get_num_new_matched_tokens() assigns the load to
# the FIRST child connector that reports a non-zero match
# (multi_connector.py:387-400). If LMCacheMPConnector were listed first, its
# local L2 tier would win the match on the decode side ahead of
# NixlConnector ever being asked, and the direct remote-prefill pull would
# be silently skipped every time the L2 tier has anything at all cached —
# which is most of the time. NixlConnector MUST be first on the decode side
# for the direct P->D leg to ever fire.

# NIXL side-channel: the out-of-band handshake letting the two vLLM engines
# exchange memory descriptors BEFORE any RDMA happens — NOT the data path
# itself (that's UCX over the fabric, below), but it must be reachable from
# the peer host or the whole direct leg silently never fires.
#
# Distinct ports per role (not one shared port) so a same-host debug
# bring-up (both roles temporarily on one box) cannot collide. These are
# per-role BASE ports, not fixed single ports: in an N-prefill/M-decode
# fleet, instance i of a role uses base+i (so decode instance 2 uses
# NIXL_SIDE_CHANNEL_PORT_DECODE+2, etc.) — pick the base low enough that
# base+max(N,M) doesn't collide with anything else in the "Service ports"
# section below.
NIXL_SIDE_CHANNEL_PORT_PREFILL="${NIXL_SIDE_CHANNEL_PORT_PREFILL:-5600}"
NIXL_SIDE_CHANNEL_PORT_DECODE="${NIXL_SIDE_CHANNEL_PORT_DECODE:-5601}"

# vLLM's own default for VLLM_NIXL_SIDE_CHANNEL_HOST is a loopback address,
# which only fails once the PEER tries to connect to it — i.e. deep into a
# run, long after startup looked healthy. Leave these empty to have
# scripts/common/lib.sh's setup_pd_env() autodetect
# (`hostname -I | awk '{print $1}'`) and REFUSE a loopback/empty result
# outright; set explicitly only if autodetection would pick the wrong
# interface on a multi-homed host.
PD_SIDE_CHANNEL_HOST_PREFILL="${PD_SIDE_CHANNEL_HOST_PREFILL:-}"
PD_SIDE_CHANNEL_HOST_DECODE="${PD_SIDE_CHANNEL_HOST_DECODE:-}"

# ── UCX transport strings for the compute leg — full failure-mode writeup
# lives on setup_ucx_env() in scripts/common/lib.sh. Summary:
#
#   UCX_TLS_RDMA="ib,rocm,self,sm"
#     - "ib" not "rc": the ionic (Pensando) provider exposes ud/ud_verbs to
#       UCX but NOT rc_verbs, so pinning "rc" (this repo's OLD value,
#       "rc_verbs,rc_mlx5,dc,ud,self,sm") fails outright. "ib" means
#       verbs-only, which cannot silently degrade to TCP — the property the
#       acceptance criterion needs.
#     - "rocm" IS NOT OPTIONAL and IS NOT a network transport: it is the
#       LOCAL memory-domain component (rocm_cpy/rocm_ipc) UCX needs to
#       recognize a ROCm/HIP device pointer as VRAM at all. Without it, UCX
#       reports VRAM as host memory and NIXL's registerMem() fails with
#       "VRAM memory is detected as host by UCX" — a message that reads
#       like a missing ROCm build (it is not: ucx_info -d shows
#       HAVE_ROCM 1 and rocm_cpy/rocm_ipc both enumerate) when the real
#       cause is that UCX_TLS configured the ROCm memory domain OUT.
#       Because rocm_cpy/rocm_ipc are memory-domain components, not
#       network transports, including them cannot reintroduce the TCP
#       fallback "ib" exists to prevent. Recorded as BLOCKER 7, 2026-09-11.
#   UCX_TLS_TCP="tcp,rocm,self,sm" — Phase 1 bring-up, see KV_TRANSPORT above.
#     "rocm" is here for EXACTLY the reason spelled out for UCX_TLS_RDMA
#     above, and it applies identically on the TCP path: it is a local
#     MEMORY-DOMAIN component, not a network transport. NixlConnector
#     registers vLLM's KV cache, which lives in VRAM, on both transports —
#     the transport only decides how bytes leave the node, not how UCX
#     classifies the pointer. This value was "tcp,self,sm" until 2026-09-16
#     and that was BLOCKER 7 reproduced on the TCP leg: prefill's EngineCore
#     died at startup with
#         nixl_agent.cpp: registerMem: registration failed for the
#         specified or all potential backends
#         nixl_rocm._bindings.nixlBackendError: NIXL_ERR_BACKEND
#     raised from base_worker.py's register_kv_caches(). The blocker note
#     above was written against the RDMA value and the same fix was never
#     carried across to this one. Including rocm cannot reintroduce a TCP
#     fallback here (there is nothing to fall back FROM on this path), so
#     there is no Phase-2-style purity argument against it either.
UCX_TLS_RDMA="${UCX_TLS_RDMA:-ib,rocm,self,sm}"
UCX_TLS_TCP="${UCX_TLS_TCP:-tcp,rocm,self,sm}"

# Every DSC3 fabric link is a /31 point-to-point, so prefill and decode sit
# in DIFFERENT IP subnets. UCX's RoCE reachability check derives its
# compare length from the netmask by default, which then rejects a
# perfectly routable peer as "unreachable IB device address" unless these
# two widen the check to /16 so it agrees with the fabric. Mandatory, not
# tuning — see setup_ucx_env()'s comment in scripts/common/lib.sh.
UCX_IB_GID_INDEX="${UCX_IB_GID_INDEX:-1}"
UCX_IB_ROCE_LOCAL_SUBNET="${UCX_IB_ROCE_LOCAL_SUBNET:-y}"
UCX_IB_ROCE_SUBNET_PREFIX_LEN="${UCX_IB_ROCE_SUBNET_PREFIX_LEN:-16}"

# UCX_NET_DEVICES, pinned PER HOST, not assumed symmetric: the device INDEX
# does not map to the same fabric plane on both hosts.
#
# CORRECTED 2026-09-14 by measurement (read from
# /sys/class/infiniband/*/device/net on both hosts). This comment previously
# claimed "only ionic_0/ionic_1 are confirmed to line up". That is BACKWARDS
# and was never measured:
#
#   smc1: ionic_0..7 -> benic1p1..benic8p1, all UP,  30.1.N.1/24
#   smc2: ionic_2/3/5/6 -> benic3p1/4p1/6p1/7p1, UP, 30.2.N.1/24
#         ionic_0/1/4/7 -> enp10s0/enp39s0/enp138s0/enp234s0, all DOWN
#
# So ionic_2/3/5/6 are the indices that name the same physical port and are UP
# on both hosts; ionic_0/ionic_1 are precisely the ones that DO NOT correspond.
# The old ionic_0:1 default below was therefore wrong on smc2 — it pinned UCX to
# a down, unrelated interface, which would fail as an unreachable peer rather
# than as an obviously bad device name.
#
# The defaults stay at ionic_0:1 ONLY because this file must not encode one
# lab's topology; the real per-host values belong in the creds file, where
# setup-4 now pins both roles to ionic_2:1. scripts/{prefill,decode}/01-host-prep.sh
# reports the live ionic_* -> port mapping so this can be re-derived, not
# assumed, whenever the fabric changes. See docs/TODO.md 2.8.
PREFILL_UCX_NET_DEVICES="${PREFILL_UCX_NET_DEVICES:-ionic_0:1}"
DECODE_UCX_NET_DEVICES="${DECODE_UCX_NET_DEVICES:-ionic_0:1}"

# Required alongside the UCX ROCm memory domain (UCX_TLS_RDMA's "rocm"
# component, above) for the same HIP-IPC KV tensor export path this file's
# PYTORCH_HIP_ALLOC_CONF note (below, in the vLLM section) also guards.
NCCL_CUMEM_ENABLE="${NCCL_CUMEM_ENABLE:-1}"

# LMCacheMPConnector's own out-of-band control channel to the LMCache MP
# daemon — distinct from both the NIXL side channel above and the
# in-process LMCacheConnectorV1 YAML surface's storage-tier config (removed,
# see TODO 6.23).
#
# MP mode means the LMCache instance is a SEPARATE HOST PROCESS (a daemon),
# reached over ZMQ — never in-process with vLLM and never containerised.
# LMCACHE_MP_HOST is loopback by design, and that is correct here (not just
# convenient): the daemon runs as a separate process on the SAME host as the
# vLLM engine it serves, which means the two share the host's IPC namespace.
# That sharing is REQUIRED, not incidental — LMCache's MemoryObjMetadata.
# address is a raw pointer that crosses the ZMQ boundary between vLLM and
# the daemon, and a raw pointer is only meaningful to a process in the same
# address space's host (mmap/shm-backed) IPC namespace. Point this at a
# different host and the pointer LMCache hands back is garbage the moment it
# crosses a real network.
#
# Port default (6557) matches the vendor reference deployment for the
# LMCache MP daemon.
LMCACHE_MP_HOST="${LMCACHE_MP_HOST:-tcp://127.0.0.1}"
LMCACHE_MP_PORT="${LMCACHE_MP_PORT:-6557}"

# Field name vLLM's NixlConnector uses to carry handoff metadata in a
# completion response / request body.
#
# VERIFIED 2026-09-15 against the installed vLLM 0.26.0+rocm: the name is
# "kv_transfer_params" on BOTH the request and the response side, and the
# reference implementation is
# /app/vllm/tests/v1/kv_connector/nixl_integration/toy_proxy_server.py
# inside the rocm-aic image. The handshake is THREE steps, not two — the
# proxy must first ASK for the handoff by sending
# kv_transfer_params={"do_remote_decode": true, ...} on the priming
# request; only then does prefill return a populated one to thread into
# decode. See scripts/proxy/disagg_proxy.py's module docstring.
#
# An earlier pass recorded this field as "unused — the vendored
# disagg_proxy_demo.py threads no handoff at all". That was reading an
# ABSENCE as a design decision: the demo proxy simply implements a
# different connector's protocol, and using it with NixlConnector produces
# a pipeline that serves correct text while transferring zero KV.
#
# Kept CONFIGURABLE, not hardcoded, because this is the one name whose
# silent drift would re-disable disaggregation without any error.
PD_HANDOFF_FIELD="${PD_HANDOFF_FIELD:-kv_transfer_params}"

# ─────────────────────────────────────────────────────────────────────────────
# Data-plane NICs
# ─────────────────────────────────────────────────────────────────────────────
# Storage leg: SMC1/SMC2 -> SMC3. Interface carrying NVMe-oF traffic.
# Compute leg: SMC1 <-> SMC2 direct NIXL/UCX side channel.
PREFILL_DATA_IF="${PREFILL_DATA_IF:-}"     # autodetected by 01-host-prep.sh if empty
DECODE_DATA_IF="${DECODE_DATA_IF:-}"
TARGET_DATA_IF="${TARGET_DATA_IF:-}"

# Compute leg (P<->D) UCX TCP device, PER ROLE. Deliberately SEPARATE from
# *_DATA_IF above, which names the storage-leg NIC — conflating the two is
# what broke leg A.
#
# MEASURED 2026-09-15, and this is why the variable exists at all: with
# UCX_NET_DEVICES unset, UCX enumerates every TCP-capable interface in the
# host netns and advertises the FIRST one in its worker address. On the
# prefill node that is benic1p1 (30.1.1.1) — a fabric NIC the decode node
# has no route to (TODO 3.6). Decode's loadRemoteMD() then spends ~133 s in
# connect() before failing NIXL_ERR_BACKEND, and every request 500s.
# Observed verbatim:
#     connect(fd=33, dest_addr=30.1.1.1:55385) failed: Connection timed out
#     UCX endpoint create failed: failed to create ep
#     loadRemoteMD: error loading connection info for backend 'UCX'
# Pinning both roles to the shared management /24 interface makes the same
# handshake succeed in under a second.
#
# NOTE this is the MANAGEMENT NIC on purpose, for Phase 1 TCP only. It is
# a 1 GbE path and is NOT a representative transport number — the fabric
# NICs are the intended carrier and are blocked on TODO 3.6. Phase 2
# (KV_TRANSPORT=rdma) uses PREFILL_UCX_NET_DEVICES/DECODE_UCX_NET_DEVICES
# instead and never consults this.
#
# Left EMPTY by default so setup_ucx_env() dies with an actionable message
# rather than letting UCX pick. There is no safe generic default: the right
# interface is whichever one has a route to the peer, which only the
# operator knows.
PREFILL_PD_IF="${PREFILL_PD_IF:-}"
DECODE_PD_IF="${DECODE_PD_IF:-}"

# RDMA device names (Phase 2 only; `ibv_devinfo` / `rdma link show`)
PREFILL_RDMA_DEV="${PREFILL_RDMA_DEV:-}"
DECODE_RDMA_DEV="${DECODE_RDMA_DEV:-}"
TARGET_RDMA_DEV="${TARGET_RDMA_DEV:-}"

# ─────────────────────────────────────────────────────────────────────────────
# Storage-leg backend selector (leg B: compute nodes -> SMC3 target)
# ─────────────────────────────────────────────────────────────────────────────
# KV_BACKEND is the SINGLE switch between the two NIXL plugins this repo
# vendors for the storage leg — everything downstream (scripts/common/lib.sh's
# setup_nixl_kv_env(), scripts/common/start-lmcache-daemon.sh's own
# KV_BACKEND branching, and the verify ladder in scripts/verify/) branches
# on this one variable, nothing else:
#
#   XNVME_KV (default)      Kernel nvme-of initiator (stock `nvme` driver,
#                           no vfio-pci, no DPDK/SPDK version pairing to get
#                           wrong) plus libxnvme's io_uring_cmd passthru
#                           against a KV namespace's generic character
#                           device, e.g. /dev/ng1n1 (plugins/xnvme-kv/). See
#                           that plugin's header comment for the full case
#                           for why this path exists alongside SPDK — in
#                           short, Docker's VFIO DMA mapping for this admin
#                           queue has been unreliable in a container, and
#                           this path sidesteps VFIO/hugepages entirely.
#
#   SPDK_NVMe_KV            Userspace SPDK NVMe-oF/TCP initiator
#                           (plugins/nvme-kv/), TRID-addressed against the
#                           nvmf_tgt this file's "NVMe-oF target" /
#                           "KV namespace geometry" sections below configure.
#                           Retained and still wired end-to-end — the build
#                           step, the plugin, the lib.sh arm, the LMCache
#                           L2-adapter spec and the verify ladder all still
#                           branch on it — but it is no longer the default.
#
# Switching this ALSO switches the effective max_value_size (see
# KV_MAX_VALUE_SIZE_XNVME below) — which means switching KV_BACKEND requires
# draining the namespace exactly the same way changing KV_MAX_VALUE_SIZE
# does. See that variable's comment for why; it is not optional.
#
# DECIDED 2026-09-16: XNVME_KV is the canonical backend. SPDK_NVMe_KV is
# deliberately KEPT working rather than deleted, so the comparison stays
# available and so a regression in one can be attributed against the other.
# The decision rests on measured history, not preference:
#
#   - The CSI-1 kernel blocker that made XNVME_KV unusable is CLOSED. On
#     5.15 `nvme connect` logged `unknown csi 1` and created no device node
#     at all; on 6.8 it logs `block device for nsid 1 not supported (csi 1)`
#     and DOES create the generic char device. HANDOFF §10.4's re-test
#     passed (TODO 6.8), and the path was then proven end to end (§10.5,
#     TODO 6.12).
#   - It needs no vfio-pci, no hugepages and no DPDK/SPDK version pairing,
#     which removes a whole class of the failures §10.4 and §12 record.
#   - The rocm-aic image already ships the XNVME_KV plugin in all three of
#     LMCache's hardcoded backend tuples (§12.2), so no patch is required.
#
# Switching backends requires draining the namespace — see the
# KV_MAX_VALUE_SIZE_* comments below. It is not a free toggle.
KV_BACKEND="${KV_BACKEND:-XNVME_KV}"

# ── XNVME_KV knobs — read ONLY when KV_BACKEND=XNVME_KV. Ignored, and left
#    unexported by scripts/common/lib.sh's setup_nixl_kv_env(), when
#    KV_BACKEND=SPDK_NVMe_KV; do not read them from an SPDK code path. ──────
#
# XNVME_DEV: the KV namespace's char device, e.g. /dev/ng1n1. Defaults to
# EMPTY deliberately — this file cannot know, for an arbitrary lab, which
# /dev/ngXnY index the KV controller landed on. That index is NOT stable: per
# plugins/xnvme-kv/xnvme_kv_backend.cpp's discover_kv_device() comment, the
# controller takes whatever index is free, which already differs between two
# otherwise-identical hosts and can move across a single host's own reboots.
#
# Resolved at RUNTIME by NQN, not pinned here: scripts/common/lib.sh's
# resolve_xnvme_kv_dev() matches the char device whose controller answers to
# ${NVMF_SUBNQN} (the same subsystem NQN the SPDK path's KV_TRID uses) and
# fills this in before the plugin ever sees it. That is what makes it safe
# for this to be a kernel nvme-of session established by `nvme connect`
# against SMC3, rather than a guess at a /dev/ngXnY index.
#
# *** WARNING: DO NOT HAND-PIN THIS TO /dev/ng0n1. ***
# On smc1/smc2, /dev/ng0n1 is the Micron OS BOOT drive (it carries partitions
# nvme0n1p1/nvme0n1p2 — a live block device is present, which a real KV
# namespace never has, see the block-device safety check in
# scripts/common/lib.sh). /dev/ng1n1 is typically the Pensando DSC
# (PDSNVME-00) or the connected KV namespace, but that index is exactly the
# kind of guess resolve_xnvme_kv_dev() exists to avoid making — hand-pinning
# a value here bypasses NQN resolution and, if it lands on the wrong index,
# does not fail loudly: it lets the KV backend issue vendor passthru I/O
# straight at the running OS disk and destroys the node. Leave this empty
# and let it resolve by NQN; only override with an exact, verified path.
XNVME_DEV="${XNVME_DEV:-}"

# NIXL_XNVME_NSID: 0 = ask the device (xnvme_dev_get_nsid() after open) —
# see xnvme_kv_backend.cpp's constructor. Only override if a single
# controller exposes more than one KV namespace and the wrong one gets
# selected by default.
XNVME_NSID="${XNVME_NSID:-0}"

# Worker count: one xnvme_dev + one xnvme_queue + one reactor pthread per
# worker (xnvme_kv_backend.h's QueueWorker). Mirrors KV_NUM_QPAIRS's role for
# the SPDK path — both size "how many independent I/O queues does this
# initiator open against the target" — so the two backends are tuned the
# same way by default rather than requiring a reader to know two different
# defaults meant the same thing.
XNVME_NUM_QUEUES="${XNVME_NUM_QUEUES:-8}"

# How long a queue may make ZERO forward progress before its outstanding work
# is failed rather than left hanging forever. 0 disables the watchdog. See
# xnvme_kv_backend.h's stall_timeout_ns_ comment: on the real Pensando DSC
# this project targets, "stops completing and never recovers" is a
# documented failure mode, and the only real recovery is an out-of-band
# DPU-side restart — this bound exists to turn a permanent hang into a
# reported error instead of an unbounded checkXfer()/waitXfer() stall.
XNVME_STALL_TIMEOUT_SEC="${XNVME_STALL_TIMEOUT_SEC:-30}"

# ─────────────────────────────────────────────────────────────────────────────
# NVMe-oF target (SMC3) — consumed by the SPDK_NVMe_KV NIXL plugin's TRID
# ─────────────────────────────────────────────────────────────────────────────
# TCP, unconditionally. rocm-aic/target.sh — the PROVEN target configuration
# this section's values are now taken from — never brings up an RDMA nvmf
# transport at all; do not resurrect a KV_TRANSPORT-driven RDMA branch here
# (see the "Transport selection" comment above).
NVMF_TRTYPE="${NVMF_TRTYPE:-TCP}"
NVMF_ADRFAM="${NVMF_ADRFAM:-IPv4}"
NVMF_TRADDR="${NVMF_TRADDR:-${TARGET_HOST}}"
NVMF_TRSVCID="${NVMF_TRSVCID:-4420}"
NVMF_SUBNQN="${NVMF_SUBNQN:-nqn.2024-01.io.nixl:kv0}"
NVMF_HOSTNQN_PREFILL="${NVMF_HOSTNQN_PREFILL:-nqn.2024-01.io.nixl:host:smc1}"
NVMF_HOSTNQN_DECODE="${NVMF_HOSTNQN_DECODE:-nqn.2024-01.io.nixl:host:smc2}"

# ── Transport + iobuf sizing — PROVEN values from rocm-aic/target.sh ───────
# Full provenance (measured failures, dates) lives in that file's own
# comments and is carried into scripts/target/lib-kv-rpc.sh's
# kv_target_check_sgl() / kv_target_gen_json_config().
#
# The hard constraint nvmf_tcp_create() enforces is
#   max_io_size / large_bufsize <= SPDK_NVMF_MAX_SGL_ENTRIES (16)
# NOTE the denominator: large_bufsize (below), NOT io_unit_size. An earlier
# version of this file asserted the ratio against io_unit_size, which is
# simply wrong once buffer sizing comes from the iobuf pool — nvmf_tcp_
# create() sizes its SGL buffers from iobuf's large_bufsize, not io_unit_
# size. iobuf's DEFAULT large_bufsize is 132KB, which caps max_io_size at
# ~2MB regardless of io_unit_size; raising large_bufsize to 1MiB (below) is
# what lifts the ceiling to 16 x 1MiB = 16MiB.
NVMF_MAX_IO_SIZE="${NVMF_MAX_IO_SIZE:-16777216}"
NVMF_IO_UNIT_SIZE="${NVMF_IO_UNIT_SIZE:-1048576}"

# max_io_qpairs_per_ctrlr — EXACT key, value 512. Confirm with:
#     rpc.py nvmf_get_transports | grep max_io_qpairs_per_ctrlr
# SPDK silently IGNORES the older spelling "max_qpairs_per_ctrlr" — no
# error, the RPC succeeds, and the default 127 stays in force. SPDK's
# default is 127 io qpairs, and ONE SPDK_NVMe_KV plugin instance opens all
# of them on its single controller — fine for a single-node deploy, but it
# makes P+D IMPOSSIBLE against a shared target: whichever role connects
# first takes the entire budget, and the second role's I/O queue is
# refused. The observable symptom is NOT an out-of-resources message — it is
#     nvme_qpair.c: *ERROR*: [...,qid:1,...,DISCONNECTED] CQ transport error -6
#     nixl_agent.cpp: getXferStatus: backend 'SPDK_NVMe_KV' NIXL_ERR_BACKEND
# on the client, while LMCache still logs "Stored N out of N tokens" and the
# HTTP request returns 200 — zero bytes reach the device. Confirmed
# 2026-09-07 with nvmf_subsystem_get_controllers reporting a single
# controller holding num_io_qpairs=128. 512 leaves room for both P/D roles
# plus headroom. scripts/target/04-verify-target.sh HARD-checks that this
# field actually took — it is the single most important check in that file.
NVMF_MAX_IO_QPAIRS_PER_CTRLR="${NVMF_MAX_IO_QPAIRS_PER_CTRLR:-512}"

# iobuf pool sizing — rocm-aic/target.sh's proven iobuf_set_options block,
# verbatim. See the max_io_size/large_bufsize note above for why
# large_bufsize is the one that actually governs the SGL ceiling.
NVMF_SMALL_POOL_COUNT="${NVMF_SMALL_POOL_COUNT:-16384}"
NVMF_LARGE_POOL_COUNT="${NVMF_LARGE_POOL_COUNT:-1024}"
NVMF_SMALL_BUFSIZE="${NVMF_SMALL_BUFSIZE:-8192}"
NVMF_LARGE_BUFSIZE="${NVMF_LARGE_BUFSIZE:-1048576}"

# The full TRID string handed to the plugin via NIXL_KV_TRID.
# Format is SPDK's spdk_nvme_transport_id_parse() syntax.
KV_TRID="${KV_TRID:-trtype:${NVMF_TRTYPE} adrfam:${NVMF_ADRFAM} traddr:${NVMF_TRADDR} trsvcid:${NVMF_TRSVCID} subnqn:${NVMF_SUBNQN}}"

# ─────────────────────────────────────────────────────────────────────────────
# KV namespace geometry (SMC3) — PROVEN values from rocm-aic/target.sh
# ─────────────────────────────────────────────────────────────────────────────
# bdev_kvmalloc_create takes name/max_key_size/max_value_size — NOT the
# -b/-s/--value-max-size shape an earlier version of this file guessed at
# for a fork whose RPC surface was never vendored here. There is also no
# total-size RPC param: bdev_kvmalloc is an in-memory red-black tree sized
# only by its per-key/per-value ceilings, not a fixed byte budget.
# KV_BDEV_SIZE_GB (formerly here) is therefore DELETED, not renamed — it
# never mapped to anything bdev_kvmalloc_create accepts, and an unused knob
# that LOOKS load-bearing is worse than no knob at all.
KV_BDEV_NAME="${KV_BDEV_NAME:-KvMalloc0}"
KV_BDEV_MAX_KEY_SIZE="${KV_BDEV_MAX_KEY_SIZE:-16}"   # comfortably covers the plugin's 12-byte keys
KV_BDEV_VALUE_MAX="${KV_BDEV_VALUE_MAX:-67108864}"   # 64 MiB device-side value ceiling

# max_value_size the SPDK_NVMe_KV PLUGIN advertises to LMCache. Deliberately
# NOT the device ceiling: it is the NVMe-oF transport SGL ceiling with
# PDU-framing headroom. LMCache's multipart split consumes this to chop a
# ~5.7 MB KV page into <=KV_MAX_VALUE_SIZE sub-transfers. Changing it
# silently changes on-wire geometry and makes previously-stored objects
# reassemble half-stale — drain the namespace
# (scripts/target/50-reset-namespace.sh) whenever you change it.
#
# This value is SPDK-specific and stays exactly as it always has: it is NOT
# read directly by anything that needs to be backend-aware (see
# KV_MAX_VALUE_SIZE_EFFECTIVE below for that). Keeping it untouched here,
# rather than folding it into a single backend-switched variable, is what
# makes KV_BACKEND=SPDK_NVMe_KV byte-identical to this file's pre-XNVME_KV
# behavior — nothing about this line's meaning changed by XNVME_KV existing.
KV_MAX_VALUE_SIZE="${KV_MAX_VALUE_SIZE:-524288}"

# max_value_size the XNVME_KV plugin advertises, compiled into
# plugins/xnvme-kv/xnvme_kv_backend.h as XNVME_KV_DEFAULT_MAX_VALUE_SIZE.
# NOT an SGL/transport headroom number like KV_MAX_VALUE_SIZE above — this
# one is a MEASURED hardware ceiling: 32768 bytes stores/retrieves cleanly
# against the real Pensando DSC, 65536 fails with a vendor-specific NVMe
# completion status (sct=7 sc=234).
#
# RE-MEASURED 2026-09-17 and the boundary is now EXACT. Single-value stores
# (num_parts=1) with NIXL_XNVME_KV_DEBUG=1, reading the device completion:
#   32768 -> ok=1 sct=0 sc=0 (and reads back cross-node); 33792, 34816,
#   36864, 40960, 49152, 65536, 131072 -> all ok=0 sct=7 sc=234.
# 32768 + 1 KiB already fails, so 32768 is the ceiling, not merely a safe
# point. 64k and 128k do NOT work on this firmware.
#
# The device ADVERTISES value_max=4096 in its KV Identify Namespace — that
# field understates the real ceiling by 8x, which is why the plugin treats a
# configured > advertised disagreement as a WARNING and not a refusal to
# start (see query_max_value_size() in plugins/xnvme-kv/xnvme_kv_backend.cpp,
# and NIXL_KV_STRICT_DEVICE_CEILING if you want the strict behaviour on
# hardware whose advertised value you trust).
#
# It is dramatically smaller than
# KV_MAX_VALUE_SIZE (524288) precisely because it is bounded by DSC firmware,
# not by an NVMe-oF/TCP transport parameter this repo tunes — do not "fix"
# the mismatch by making the two equal; they bound different things.
KV_MAX_VALUE_SIZE_XNVME="${KV_MAX_VALUE_SIZE_XNVME:-32768}"

# The BACKEND-AWARE effective value, selected by KV_BACKEND — this is what
# the in-process LMCacheConnectorV1 YAML surface (removed, see TODO 6.23)
# and the verify ladder (scripts/verify/20-verify-nixl-plugin.sh,
# 30-verify-kv-roundtrip.sh, _kv_roundtrip.py) actually consume, NOT the two
# backend-specific variables above directly, so that neither script has to
# duplicate this branch.
#
# THIS IS THE SAME on-wire-geometry HAZARD AS KV_MAX_VALUE_SIZE ITSELF, SAID
# AGAIN BECAUSE IT MATTERS MORE HERE: switching KV_BACKEND changes this
# value (524288 <-> 32768) exactly as if KV_MAX_VALUE_SIZE had been edited
# directly — LMCache's multipart split recomputes
# n = ceil(page_size / max_value_size) from whatever this resolves to right
# now, with no record of what an already-stored object was split under. Flip
# KV_BACKEND against a namespace that already holds objects written under
# the OTHER backend's geometry and reads reassemble half-stale pages
# silently (the completion path checks status, not returned length — see
# plugins/xnvme-kv/xnvme_kv_plugin.cpp's getParams() comment, which
# documents the identical hazard for XNVME_KV that
# plugins/nvme-kv/spdk_nvme_kv_plugin.cpp's getParams() already documents
# for SPDK). DRAIN THE NAMESPACE (scripts/target/50-reset-namespace.sh)
# EVERY TIME KV_BACKEND CHANGES — treat a backend switch as exactly as
# destructive to existing KV content as an explicit KV_MAX_VALUE_SIZE edit,
# because as far as the on-wire geometry is concerned, it is one.
case "${KV_BACKEND}" in
    XNVME_KV)     KV_MAX_VALUE_SIZE_EFFECTIVE="${KV_MAX_VALUE_SIZE_EFFECTIVE:-${KV_MAX_VALUE_SIZE_XNVME}}" ;;
    SPDK_NVMe_KV) KV_MAX_VALUE_SIZE_EFFECTIVE="${KV_MAX_VALUE_SIZE_EFFECTIVE:-${KV_MAX_VALUE_SIZE}}" ;;
    *) KV_MAX_VALUE_SIZE_EFFECTIVE="${KV_MAX_VALUE_SIZE_EFFECTIVE:-${KV_MAX_VALUE_SIZE}}" ;;
esac

# SPDK reactor / qpair sizing on the INITIATOR side (prefill + decode).
KV_NUM_QPAIRS="${KV_NUM_QPAIRS:-8}"
KV_QUERY_TIMEOUT_MS="${KV_QUERY_TIMEOUT_MS:-2000}"
KV_ENOMEM_TIMEOUT_SEC="${KV_ENOMEM_TIMEOUT_SEC:-30}"
KV_BACKPRESSURE_LOG_SEC="${KV_BACKPRESSURE_LOG_SEC:-60}"

# Per-deployment key-space offsets. Only load-bearing on the devId key path
# (metaInfo-less callers: kv_io.py, nixlbench). LMCache OBJ mode derives keys
# from metaInfo and ignores these. Kept disjoint so the two are never wrong.
KV_SLOT_OFFSET_PREFILL="${KV_SLOT_OFFSET_PREFILL:-0}"
KV_SLOT_OFFSET_DECODE="${KV_SLOT_OFFSET_DECODE:-1048576}"

# ─────────────────────────────────────────────────────────────────────────────
# Model + vLLM
# ─────────────────────────────────────────────────────────────────────────────
# Qwen 72B. bf16 weights are ~145 GB; at TP=8 across MI300X (192 GB HBM3 each)
# that is ~18 GB/GPU, leaving the overwhelming majority of HBM for KV cache —
# which is the point: a large KV working set is what makes the remote L2 tier
# on SMC3 worth measuring at all. A model small enough to keep its whole cache
# resident would never exercise the storage path.
#
# Alternates (set MODEL to override):
#   Qwen/Qwen2.5-72B-Instruct      default; 32K native ctx, 131K with YaRN
#   Qwen/Qwen2.5-72B-Instruct-AWQ  4-bit, ~40 GB, for TP=4 or memory-tight runs
#   Qwen/Qwen2.5-32B-Instruct      faster iteration during bring-up
# Note there is no Qwen3 72B — the Qwen3 dense line tops out at 32B.
MODEL="${MODEL:-Qwen/Qwen2.5-72B-Instruct}"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-${MODEL}}"
TP_SIZE="${TP_SIZE:-8}"
# Qwen2.5-72B is natively 32768. Going to 131072 requires the YaRN rope_scaling
# override AND materially more KV per sequence — do that deliberately, not by
# accident, via MAX_MODEL_LEN + VLLM_EXTRA_ARGS.
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.85}"
BLOCK_SIZE="${BLOCK_SIZE:-64}"
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-auto}"
VLLM_ATTENTION_BACKEND="${VLLM_ATTENTION_BACKEND:-TRITON_ATTN}"
HF_TOKEN="${HF_TOKEN:-}"
HF_HOME="${HF_HOME:-/data/hf}"

# ─────────────────────────────────────────────────────────────────────────────
# Service ports
# ─────────────────────────────────────────────────────────────────────────────
PREFILL_PORT="${PREFILL_PORT:-8100}"
DECODE_PORT="${DECODE_PORT:-8200}"

# Fleet-wide port lists — the "Node topology" section above documents the
# PREFILL_HOSTS/DECODE_HOSTS half of the N-prefill/M-decode upgrade seam;
# these are the matching port half. Same rule: the singular PREFILL_PORT/
# DECODE_PORT stay canonical (first element / the local instance's port),
# these plural, space-separated lists default to a single-entry list built
# from the singular so 1P1D is unaffected, and growing to NPMD means adding
# entries here plus teaching the proxy to balance across them.
PREFILL_PORTS="${PREFILL_PORTS:-${PREFILL_PORT}}"
DECODE_PORTS="${DECODE_PORTS:-${DECODE_PORT}}"

PROXY_PORT="${PROXY_PORT:-8000}"
PROXY_HOST="${PROXY_HOST:-${DECODE_HOST}}"

# NIXL direct P<->D side channel ports moved to the "Compute leg (P->D)"
# section above (NIXL_SIDE_CHANNEL_PORT_PREFILL / _DECODE) — this single,
# never-wired-up NIXL_SIDE_CHANNEL_PORT is gone, not renamed: one shared
# port could never have worked for a same-host debug bring-up of both
# roles, and nothing in the repo read it before this task.

# LMCache
LMCACHE_CHUNK_SIZE="${LMCACHE_CHUNK_SIZE:-256}"
LMCACHE_MAX_LOCAL_CPU_SIZE="${LMCACHE_MAX_LOCAL_CPU_SIZE:-80}"   # GiB of host DRAM (L1)

# Observability
NIXL_METRICS_INTERVAL_SEC="${NIXL_METRICS_INTERVAL_SEC:-10}"
SPDK_RPC_SOCK="${SPDK_RPC_SOCK:-/var/tmp/spdk.sock}"

# ─────────────────────────────────────────────────────────────────────────────
# Build paths (identical on all three nodes unless overridden)
# ─────────────────────────────────────────────────────────────────────────────
STACK_ROOT="${STACK_ROOT:-/opt/kvstack}"
NIXL_PREFIX="${NIXL_PREFIX:-${STACK_ROOT}/nixl}"
NIXL_SRC="${NIXL_SRC:-${STACK_ROOT}/src/nixl}"
NIXL_VERSION="${NIXL_VERSION:-v1.4.1}"
UCX_PREFIX="${UCX_PREFIX:-${STACK_ROOT}/ucx}"
UCX_SRC="${UCX_SRC:-${STACK_ROOT}/src/ucx}"
UCX_BRANCH="${UCX_BRANCH:-v1.19.x}"
# ── SPDK ─────────────────────────────────────────────────────────────────────
# NVIDIA's NVMe Key-Value command-set patches (Ben Walker <ben@nvidia.com>,
# review.spdk.io topic:kv), verified status as of 2026-09-14:
#
#   0001 nvme: recognize KV namespaces   Gerrit 28260  MERGED  2026-08-25 (8dc8327)
#   0002 bdev/kvmalloc                   Gerrit 27889  OPEN    CR+2, Verified+1, hashtag 26.09
#   0003 nvmf: KV namespace support      Gerrit 28298  OPEN    CR+2 (x2), Verified+1, hashtag 26.09; depends on 0002
#   0004 nvme: KV unit tests             Gerrit 27886  MERGED  2026-08-25 (b12a372)
#
# include/spdk/nvme_kv.h and the initiator API
# (spdk_nvme_kv_{store,retrieve,delete,exist,list}()) landed in v26.05 —
# that is the entire INITIATOR surface, so SMC1/SMC2 build stock upstream.
#
# 0001/0004 are already present on any CURRENT master checkout (merged
# 2026-08-25) and are therefore redundant to apply there — harmless, but
# pointless; scripts/target/02-build-spdk-kv.sh detects this by content and
# skips them rather than assuming based on ref name. 0002/0003 are the
# TARGET-side patches (bdev_kvmalloc + nvmf KV opcode routing) and are the
# ONLY ones that must actually be carried by this repo — they have not
# merged as of this writing. Full per-patch status, Gerrit links, and
# Change-Ids: patches/spdk/README.md.
#
# There is NO private fork. These are upstream-bound patches on a public
# Gerrit review queue (review.spdk.io), authored by NVIDIA. An earlier
# version of this file pointed a KV_SPDK_REPO "fork URL" at nothing and
# treated its absence as a hard blocker that does not describe reality —
# that variable (and KV_SPDK_REF, SPDK_TARGET_FLAVOR) has been removed.
SPDK_VERSION="${SPDK_VERSION:-v26.05}"
SPDK_UPSTREAM_REPO="${SPDK_UPSTREAM_REPO:-https://github.com/spdk/spdk}"

# Initiator (SMC1/SMC2): stock upstream v26.05+, no patches needed.
SPDK_INITIATOR_FLAVOR="${SPDK_INITIATOR_FLAVOR:-upstream}"   # upstream|fork
SPDK_SRC="${SPDK_SRC:-${STACK_ROOT}/src/spdk}"

# Whether the initiator's own SPDK build links the target-side nvmf
# transport object (--with-nvmf) — OPT-IN, default off, purely to keep this
# tree comparable to the target's for diffing configure summaries; nothing
# on the initiator role ever calls into it. Full rationale on the
# ./configure call itself: scripts/common/05-build-spdk-initiator.sh.
SPDK_INITIATOR_WITH_NVMF="${SPDK_INITIATOR_WITH_NVMF:-0}"

# Target (SMC3): upstream + patches/spdk/000{2,3}-*.patch applied on top
# (scripts/target/02-build-spdk-kv.sh). SPDK_TARGET_REF pins the base this
# is built from — "master" tracks HEAD (already carries 0001/0004); pin an
# explicit SHA instead for a reproducible build. Re-check
# https://review.spdk.io/q/topic:kv+status:open periodically: 0002/0003 may
# merge into v26.09, at which point they become as redundant as 0001/0004
# already are on master.
SPDK_TARGET_REF="${SPDK_TARGET_REF:-master}"
# REPO_ROOT is exported by scripts/common/lib.sh before it sources this file,
# but cluster.env must also survive being sourced standalone (operators do this
# to inspect resolved values, and `set -u` then makes an unguarded ${REPO_ROOT}
# a hard error). Derive it from this file's own location as the fallback.
SPDK_PATCH_DIR="${SPDK_PATCH_DIR:-${REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}/patches/spdk}"
SPDK_TARGET_SRC="${SPDK_TARGET_SRC:-${STACK_ROOT}/src/kv_spdk}"

ROCM_PATH="${ROCM_PATH:-/opt/rocm}"
ROCM_ARCH="${ROCM_ARCH:-gfx942}"                # MI300X
VENV="${VENV:-${STACK_ROOT}/venv}"
LOG_DIR="${LOG_DIR:-/var/log/kvstack}"
RUN_DIR="${RUN_DIR:-/run/kvstack}"

# NIXL plugin discovery — where our two plugins get installed.
NIXL_PLUGIN_DIR="${NIXL_PLUGIN_DIR:-${NIXL_PREFIX}/lib/x86_64-linux-gnu/plugins}"

# Hugepages for SPDK initiators (SMC1/SMC2 — the plugin embeds SPDK/DPDK
# EAL). The TARGET does NOT use this: see TARGET_HUGE_PAGES below, which
# defaults to 0 (malloc-backed, --no-huge) matching rocm-aic/target.sh's
# proven configuration exactly.
HUGEPAGE_COUNT="${HUGEPAGE_COUNT:-8192}"        # 8192 x 2 MiB = 16 GiB

# ── SPDK target (SMC3) runtime knobs — from rocm-aic/target.sh ────────────
# TARGET_HUGE_PAGES=0 (default): nvmf_tgt runs --no-huge -s ${TARGET_MEM_MB}
# (malloc-backed DPDK EAL memory, no hugetlbfs dependency at all) — this IS
# rocm-aic/target.sh's proven default, not a fallback. Set
# TARGET_HUGE_PAGES>0 to instead allocate that many 2MiB hugepages and drop
# --no-huge/-s from the launch args (scripts/target/03-start-kv-target.sh,
# scripts/target/01-host-prep.sh).
TARGET_HUGE_PAGES="${TARGET_HUGE_PAGES:-0}"
TARGET_MEM_MB="${TARGET_MEM_MB:-4096}"
SPDK_TGT_CPUMASK="${SPDK_TGT_CPUMASK:-0x1}"

# ─────────────────────────────────────────────────────────────────────────────
# Benchmarking — llama-benchy (github.com/eugr/llama-benchy, MIT)
# ─────────────────────────────────────────────────────────────────────────────
# Chosen because it is the only endpoint-level harness that natively measures
# prefix-cache benefit: --enable-prefix-caching with --depth runs a two-step
# context-load-then-inference protocol, which is exactly the P/D question
# (does the decode node actually get a hit on what the prefill node stored?).
# It also reports e2e_ttft (first CONTENT token) separately from ttfr (first
# stream chunk) — vLLM's own harness conflates the two, which would mask the
# very latency win we are trying to prove.
# Constraint: it drives /v1/chat/completions ONLY, not /v1/completions.
BENCHY_VERSION="${BENCHY_VERSION:-0.4.0}"
BENCHY_BASE_URL="${BENCHY_BASE_URL:-http://${PROXY_HOST}:${PROXY_PORT}/v1}"
BENCHY_PP="${BENCHY_PP:-512 1024 2048}"          # prompt token counts
BENCHY_TG="${BENCHY_TG:-128 256}"                # generation token counts
BENCHY_DEPTH="${BENCHY_DEPTH:-0 4096 8192 16384}" # cached-prefix depths
BENCHY_CONCURRENCY="${BENCHY_CONCURRENCY:-1 2 4 8}"
BENCHY_RUNS="${BENCHY_RUNS:-5}"
BENCHY_WARMUP_RUNS="${BENCHY_WARMUP_RUNS:-1}"
BENCHY_LATENCY_MODE="${BENCHY_LATENCY_MODE:-generation}"
BENCHY_RESULT_DIR="${BENCHY_RESULT_DIR:-${STACK_ROOT:-/opt/kvstack}/bench}"
