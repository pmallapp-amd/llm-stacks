#!/usr/bin/env bash
# creds.env.template — template for a per-setup identity and credentials file.
#
# WHY THIS LIVES IN config/ AND NOT IN creds/
# The creds/ directory is gitignored in its entirety, with no negation
# exceptions. That is deliberate: a `!creds/something` rule is one typo away
# from tracking a real credentials file, and this repository is public. Keeping
# the template on the tracked side of that line makes an accidental commit of
# real credentials impossible rather than merely unlikely.
#
# USAGE
#   scripts/common/init-creds.sh 4          # scaffold creds/setup-4.env + symlink
# or by hand:
#   mkdir -p creds
#   cp config/creds.env.template creds/setup-4.env
#   chmod 600 creds/setup-4.env
#   $EDITOR creds/setup-4.env
#   ln -sfn setup-4.env creds/active.env
#
# HOW IT IS CONSUMED
# config/cluster.env sources ${CREDS_FILE:-<repo>/creds/active.env} BEFORE
# applying any of its own defaults, so every value set here wins. Anything you
# leave unset falls back to a placeholder on the reserved .invalid TLD
# (RFC 2606), which fails DNS immediately and unmistakably instead of resolving
# to something real and pointing the cluster at a stranger's machine.
#
# Run several labs by keeping setup-1.env, setup-2.env, ... side by side and
# repointing the symlink. Point somewhere else entirely with
# CREDS_FILE=/path/to/other.env.
#
# NOTHING IN THIS FILE IS SECRET. Every value below is a placeholder.
#
# shellcheck disable=SC2034

# ─────────────────────────────────────────────────────────────────────────────
# Nodes
# ─────────────────────────────────────────────────────────────────────────────
# The prefill node. Needs GPUs; runs vLLM as the KV producer.
PREFILL_HOST="10.0.0.1"
PREFILL_NAME="prefill"
PREFILL_USER="root"
PREFILL_PASS="<password>"

# The decode node. Needs GPUs; runs vLLM as the KV consumer.
DECODE_HOST="10.0.0.2"
DECODE_NAME="decode"
DECODE_USER="root"
DECODE_PASS="<password>"

# The storage target. No GPU required; runs the SPDK NVMe-KV target.
TARGET_HOST="10.0.0.3"
TARGET_NAME="target"
TARGET_USER="root"
TARGET_PASS="<password>"

# User for ssh between nodes. Key-based auth is strongly preferred over the
# passwords above, which exist so the scripts can document the lab rather than
# so anything automated types them.
SSH_USER="root"

# ─────────────────────────────────────────────────────────────────────────────
# BMCs (out-of-band management)
# ─────────────────────────────────────────────────────────────────────────────
# Used for power control and for reaching a node that has stopped answering on
# the data network. Not on the critical path for bring-up.
PREFILL_BMC="10.0.1.1"
PREFILL_BMC_USER="admin"
PREFILL_BMC_PASS="<password>"

DECODE_BMC="10.0.1.2"
DECODE_BMC_USER="admin"
DECODE_BMC_PASS="<password>"

TARGET_BMC="10.0.1.3"
TARGET_BMC_USER="root"
TARGET_BMC_PASS="<password>"

# ─────────────────────────────────────────────────────────────────────────────
# Serial consoles
# ─────────────────────────────────────────────────────────────────────────────
# Full command strings, so a console reachable some other way (ipmitool sol,
# conserver, a USB adapter) can be dropped in without changing any script.
# Leave empty if the lab has no console server.
PREFILL_CONSOLE="telnet 10.0.2.1 2000"
PREFILL_CONSOLE_ALT=""

DECODE_CONSOLE="telnet 10.0.2.1 2001"
DECODE_CONSOLE_ALT=""

TARGET_CONSOLE="telnet 10.0.2.1 2002"
TARGET_CONSOLE_ALT=""

# ─────────────────────────────────────────────────────────────────────────────
# Data-plane interfaces  (optional — autodetected when left empty)
# ─────────────────────────────────────────────────────────────────────────────
# Storage leg: compute nodes -> target, NVMe-oF/TCP.
PREFILL_DATA_IF=""
DECODE_DATA_IF=""
TARGET_DATA_IF=""

# Compute leg: prefill <-> decode, NIXL/UCX. These are the RDMA devices the
# acceptance criterion runs over.
#
# Pin these per host rather than assuming the index means the same thing on
# both. On the reference fabric the Nth device is NOT the same physical port on
# each machine — only the first two line up — so a symmetric guess silently
# puts the two engines on different fabric planes.
PREFILL_UCX_NET_DEVICES=""
DECODE_UCX_NET_DEVICES=""

# NIXL side-channel addresses. Leave empty to autodetect via `hostname -I`.
# MUST be an address the PEER node can reach: vLLM's own default is a loopback
# address, which fails only when the peer dials in, long after startup looked
# healthy. config/cluster.env refuses a loopback value outright.
PD_SIDE_CHANNEL_HOST_PREFILL=""
PD_SIDE_CHANNEL_HOST_DECODE=""

# ─────────────────────────────────────────────────────────────────────────────
# Secrets
# ─────────────────────────────────────────────────────────────────────────────
# Hugging Face token, needed for gated models. The default model is ~145 GB, so
# pre-stage the weights rather than discovering the download during bring-up.
HF_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# SPDK source  (optional)
# ─────────────────────────────────────────────────────────────────────────────
# The target needs upstream SPDK plus the vendored NVMe-KV patches in
# patches/spdk/. Pin a specific master SHA here for a reproducible build; see
# patches/spdk/README.md for which patches are still required.
# SPDK_TARGET_REF="master"
