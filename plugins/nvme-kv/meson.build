# meson.build for the SPDK NVMe-KV NIXL plugin.
# Links statically against the pre-built kv_spdk static libs.
# kv_spdk (26.05.0-pre + NVIDIA NVMe-KV patches) has only static libs.
#
# Required options:
#   -Dnixl_path=/usr/local/nixl   NIXL install prefix
#   -Dspdk_path=/spdk-src         kv_spdk root (headers + build/lib/*.a)
#   -Drocm_path=/opt/rocm         ROCm install prefix (staged VRAM_SEG support)
#
# The built plugin embeds SPDK code, making it larger but self-contained.
# At runtime nixl, uring, numa, aio, and libamdhip64 are needed.
project('nixl-spdk-nvme-kv-plugin', 'cpp',
    version: '0.1.0',
    default_options: ['cpp_std=c++17', 'buildtype=release'])

nixl_path = get_option('nixl_path')
spdk_path = get_option('spdk_path')
rocm_path = get_option('rocm_path')
arch = host_machine.cpu_family()
nixl_lib_dir = nixl_path + '/lib/' + arch + '-linux-gnu'
plugin_install_dir = get_option('prefix') + '/lib/' + arch + '-linux-gnu/plugins'

spdk_inc = include_directories(
    spdk_path + '/include',
    spdk_path + '/build/include',
    spdk_path + '/dpdk/build/include',
)

nixl_dep = declare_dependency(
    include_directories: include_directories(
        nixl_path + '/include',
        nixl_path + '/include/backend',
        nixl_path + '/include/utils',
    ),
    link_args: [
        '-L' + nixl_lib_dir,
        '-lnixl',
        '-Wl,-rpath,' + nixl_lib_dir,
    ])

# Static SPDK + DPDK — link the subset needed for NVMe-KV
spdk_lib_dir = spdk_path + '/build/lib'
dpdk_lib_dir = spdk_path + '/dpdk/build/lib'

spdk_dep = declare_dependency(
    link_args: [
        '-L' + spdk_lib_dir,
        '-L' + dpdk_lib_dir,
        # SPDK NVMe stack. Use --whole-archive only for the mini TCP-transport
        # archive (nvme_tcp.o + nvme_transport.o extracted from libspdk_nvme.a)
        # so that TCP self-registration constructors are included. The rest of
        # libspdk_nvme.a is linked normally (resolves symbols from the TCP objs).
        # libspdk_nvme_tcp_only.a / _pcie_only.a / sock_posix_only.a are
        # generated by prepare-spdk-libs.sh (called automatically from
        # build.sh) — not part of a stock SPDK build.
        '-Wl,--start-group',
        # Every SPDK/DPDK lib below is referenced by its EXPLICIT .a path,
        # not a bare -lNAME. Some SPDK/DPDK build configurations (observed:
        # SPDK built with `./configure --without-shared` still lets its
        # vendored DPDK submodule produce BOTH librteX.a and librteX.so.26
        # side by side in dpdk/build/lib) leave a bare -lNAME free to resolve
        # to the .so instead of the .a it's meant to statically embed here,
        # since both live in the same -L dir and ld/meson's own link-arg
        # ordering isn't reliable enough to fence with -Wl,-Bstatic/-Bdynamic
        # (tried first; meson reordered -lrte_eal to after the -Bdynamic
        # restore in the final link line -- confirmed via
        # `ninja -v -t commands`). An explicit path has no such ambiguity: ld
        # takes the named archive file directly, full stop. Getting this wrong
        # produces a plugin .so with DT_NEEDED entries on librte_eal.so.26 etc.
        # that this repo deliberately never ships in the final image (see this
        # file's own "no SPDK runtime component ships in the final image"
        # comment in the rocm-aic Dockerfile patch) -- NIXL's dlopen() of the
        # plugin then fails silently and it's reported as an "unsupported
        # backend" with zero indication a shared-lib dependency was the cause.
        # TCP transport + POSIX socket: self-register via RTE_INIT / SPDK_NVME_TRANSPORT_REGISTER.
        # PCIe transport (nvme_pcie.o): same — must be --whole-archive or PCIe is unavailable.
        '-Wl,--whole-archive,'
            + spdk_lib_dir + '/libspdk_nvme_tcp_only.a,'
            + spdk_lib_dir + '/libspdk_sock_posix_only.a,'
            + spdk_lib_dir + '/libspdk_nvme_pcie_only.a'
            + ',--no-whole-archive',
        spdk_lib_dir + '/libspdk_nvme.a',
        spdk_lib_dir + '/libspdk_dma.a',
        spdk_lib_dir + '/libspdk_bdev_kvmalloc.a',
        spdk_lib_dir + '/libspdk_bdev.a',
        spdk_lib_dir + '/libspdk_thread.a',
        spdk_lib_dir + '/libspdk_util.a',
        spdk_lib_dir + '/libspdk_log.a',
        spdk_lib_dir + '/libspdk_json.a',
        spdk_lib_dir + '/libspdk_jsonrpc.a',
        spdk_lib_dir + '/libspdk_rpc.a',
        spdk_lib_dir + '/libspdk_sock.a',
        spdk_lib_dir + '/libspdk_sock_posix.a',
        spdk_lib_dir + '/libspdk_trace.a',
        spdk_lib_dir + '/libspdk_init.a',
        spdk_lib_dir + '/libspdk_env_dpdk.a',
        spdk_lib_dir + '/libspdk_keyring.a',
        # DPDK EAL (minimal set) + ring PMD forced via whole-archive
        dpdk_lib_dir + '/librte_eal.a',
        dpdk_lib_dir + '/librte_argparse.a',
        dpdk_lib_dir + '/librte_log.a',
        dpdk_lib_dir + '/librte_mempool.a',
        '-Wl,--whole-archive,' + dpdk_lib_dir + '/librte_mempool_ring.a,--no-whole-archive',
        dpdk_lib_dir + '/librte_ring.a',
        dpdk_lib_dir + '/librte_bus_pci.a',
        dpdk_lib_dir + '/librte_pci.a',
        dpdk_lib_dir + '/librte_kvargs.a',
        dpdk_lib_dir + '/librte_telemetry.a',
        '-Wl,--end-group',
        # ISA-L (Intel CRC/crypto): SPDK builds it as a subproject; add the .a directly.
        spdk_path + '/isa-l/.libs/libisal.a',
        # System deps
        '-lnuma', '-ldl', '-lm', '-lpthread', '-lssl', '-lcrypto', '-luuid',
    ])

thread_dep = dependency('threads')
uring_dep  = dependency('liburing')
aio_dep    = declare_dependency(link_args: ['-laio'])
numa_dep   = declare_dependency(link_args: ['-lnuma'])

# Staged VRAM_SEG support (hipMemcpy through a host staging buffer — see
# spdk_nvme_kv_backend.h). Mirrors rocm-plugin/meson.build's rocm_dep.
# Optional — disable with -Denable_vram=false on GPU-less hosts (e.g. .59,
# which has Pensando DSCs but no ROCm/GPU); the plugin still builds and runs
# DRAM_SEG/FILE_SEG transfers fine, just without the VRAM_SEG code path.
enable_vram = get_option('enable_vram')
extra_deps = []
extra_cpp_args = []
extra_install_rpath = ''
if enable_vram
    extra_deps += declare_dependency(
        include_directories: include_directories(rocm_path + '/include'),
        link_args: [
            '-L' + rocm_path + '/lib',
            '-lamdhip64',
            '-Wl,-rpath,' + rocm_path + '/lib',
        ])
    extra_cpp_args += '-D__HIP_PLATFORM_AMD__'
    extra_install_rpath = ':' + rocm_path + '/lib'
else
    extra_cpp_args += '-DNIXL_KV_NO_VRAM'
endif

shared_library('plugin_SPDK_NVMe_KV',
    'spdk_nvme_kv_backend.cpp',
    'spdk_nvme_kv_plugin.cpp',
    # '.' not 'src': the sources sit flat beside this meson.build, so the
    # headers they include do too. A stale include_directories('src') is a
    # hard meson error ("Include dir src does not exist"), not a warning.
    include_directories: [include_directories('.'), spdk_inc],
    dependencies: [nixl_dep, spdk_dep, thread_dep, uring_dep, aio_dep, numa_dep] + extra_deps,
    cpp_args: ['-fPIC', '-Wno-unused-function'] + extra_cpp_args,
    # absl symbols resolved at runtime from libnixl.so
    link_args: ['-Wl,--allow-shlib-undefined'],
    name_prefix: 'lib',
    install: true,
    install_dir: plugin_install_dir,
    install_rpath: nixl_lib_dir + extra_install_rpath)
